FROM golang:1.23-alpine AS builder
WORKDIR /build
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ .
RUN CGO_ENABLED=0 go build -o /app/crypto-handler ./cmd/crypto-handler/

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
COPY --from=builder /app/crypto-handler /app/crypto-handler
ENTRYPOINT ["/app/crypto-handler"]
