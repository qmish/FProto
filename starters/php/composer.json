    "description": "FProto protocol SDK for PHP — AEAD encryption, session state machine",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
